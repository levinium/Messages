<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/condition_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Sits between two cards: every condition has to hold. -->
    <org.fossify.commons.views.MyTextView
        android:id="@+id/condition_and"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="@dimen/medium_margin"
        android:background="@drawable/block_rule_pill_background"
        android:paddingHorizontal="@dimen/activity_margin"
        android:paddingVertical="@dimen/tiny_margin"
        android:text="@string/block_rule_and"
        android:textAllCaps="true"
        android:textSize="@dimen/smaller_text_size"
        android:textStyle="bold" />

    <!-- The card: one condition, whose values are alternatives. -->
    <LinearLayout
        android:id="@+id/condition_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/medium_margin"
        android:background="@drawable/block_rule_card_background"
        android:orientation="vertical"
        android:paddingStart="@dimen/activity_margin"
        android:paddingTop="@dimen/small_margin"
        android:paddingEnd="@dimen/small_margin"
        android:paddingBottom="@dimen/medium_margin">

        <LinearLayout
            android:id="@+id/condition_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/condition_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_all_corners"
                android:drawablePadding="@dimen/tiny_margin"
                android:gravity="center_vertical"
                android:paddingVertical="@dimen/small_margin"
                android:paddingEnd="@dimen/small_margin"
                android:textSize="@dimen/normal_text_size"
                android:textStyle="bold"
                tools:text="Contains" />

            <ImageView
                android:id="@+id/condition_status"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="@dimen/medium_margin"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/condition_remove"
                android:layout_width="@dimen/normal_icon_size"
                android:layout_height="@dimen/normal_icon_size"
                android:background="@drawable/ripple_all_corners"
                android:contentDescription="@string/block_rule_remove_condition"
                android:padding="12dp"
                android:src="@drawable/ic_cross_vector" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/condition_values"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/condition_add_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_all_corners"
            android:drawablePadding="@dimen/small_margin"
            android:gravity="center_vertical"
            android:paddingVertical="@dimen/small_margin"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/medium_margin"
            android:text="@string/block_rule_add_value"
            android:textSize="@dimen/normal_text_size" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/condition_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/small_margin"
            android:alpha="0.7"
            android:textSize="@dimen/smaller_text_size"
            tools:text="Also matches inside longer words, so car matches scar" />

    </LinearLayout>
</LinearLayout>
