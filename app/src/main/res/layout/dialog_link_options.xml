<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/link_options_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/activity_margin"
    android:paddingTop="@dimen/activity_margin">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/link_full_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/link_full"
        android:textAllCaps="true"
        android:textSize="@dimen/smaller_text_size" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/link_full_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tiny_margin"
        android:ellipsize="middle"
        android:maxLines="2"
        android:textSize="@dimen/normal_text_size"
        tools:text="https://example.com/article?utm_source=newsletter" />

    <include
        android:id="@+id/link_full_actions"
        layout="@layout/layout_link_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_margin" />

    <View
        android:id="@+id/link_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="@dimen/small_margin" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/link_clean_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/link_without_parameters"
        android:textAllCaps="true"
        android:textSize="@dimen/smaller_text_size" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/link_clean_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tiny_margin"
        android:ellipsize="middle"
        android:maxLines="2"
        android:textSize="@dimen/normal_text_size"
        tools:text="https://example.com/article" />

    <include
        android:id="@+id/link_clean_actions"
        layout="@layout/layout_link_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_margin" />

</LinearLayout>
